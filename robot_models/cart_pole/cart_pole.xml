<mujoco model="cart_pole">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.001" integrator="implicitfast"></option>

  <worldbody>
    <body name="cart" pos="0 0 1">
      <inertial pos="0 0 0" mass="0.466"/>
      <joint name="cart_joint" pos="0 0 0" axis="1 0 0" type="slide" limited="false" frictionloss="0.0408"/>
      <geom size="0.025 0.025 0.025" pos="0 0 0" type="box" rgba="0 0 0.8 1"/>
      <body name="pole" pos="0 0 0">
        <inertial pos="0 0 -0.1005" mass="0.06"/>
        <joint name="pole_joint" pos="0 0 0" axis="0 1 0" limited="false" frictionloss="0.0020"/>
        <geom size="0.01 0.1005" pos="0 0 -0.1005" type="cylinder" rgba="0 0 0 1"/>
        <body name="sphere" pos="0 0 -0.206">
          <inertial pos="0 0 0" mass="0.012"/>
          <geom size="0.025" pos="0 0 0" rgba="1 0 0 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="cart_joint"/>
    <motor joint="pole_joint"/>
  </actuator>

</mujoco>